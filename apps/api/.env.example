# Copy to .env for running the API outside Docker. Placeholders only; never commit .env.
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://<DB_USER>:<DB_PASSWORD>@localhost:5432/<DB_NAME>
REDIS_URL=redis://localhost:6379/0
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=<MEILI_MASTER_KEY>
CORS_ORIGINS=http://localhost:3000
# Optional: enables TMDB posters (ADR-025). Empty = no TMDB calls, placeholders only.
# Either the v3 API key or the v4 API Read Access Token from themoviedb.org account settings.
TMDB_API_KEY=
